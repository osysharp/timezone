namespace Osysharp.TimeZone;

// ── what the app says ─────────────────────────────────────────────────────────────────────────────────────────────────

/// Who may move the app's clock — the app's admins, unless the app says otherwise:
/// `policy ManagesClock => RoleGrant.Any(g => g.Member == user && g.Role == AppRole.Lead);`
virtual policy ManagesClock => IsAdmin;

/// The clock until staff choose one — `app.Clock = new ClockSetup { TimeZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Stockholm") };`. Without
/// it, UTC and Monday.
[AppSetting("Clock")]
public class ClockSetup {
  /// The time zone days start in until staff pick one. Must be one of the app's declared zones.
  public TimeZoneInfo TimeZone = TimeZoneInfo.FindSystemTimeZoneById("UTC");
  /// The first day of a week until staff pick one.
  public DayOfWeek WeekStart = DayOfWeek.Monday;
}

// ── the setting staff keep ────────────────────────────────────────────────────────────────────────────────────────────

/// The app's clock, as staff set it. One row, made the first time the settings page is opened; none means the app's
/// `ClockSetup`. The page is generated: `ClockSettingsPage` at `/settings/clock`, which an app takes over by name.
[Settings("Time and date", Authorize = ManagesClock, Route = "/settings/clock", Order = 15, Icon = Icons.Clock,
          Hint = "The time zone the team's days start in, and the day a week starts.",
          Description = "A day here is a day where the team works: \"today\", a week and a month start at midnight in this time zone, and follow its summer time. Reports count on it, and daily mail goes out by it.",
          Saved = "Time and date saved.")]
[SettingsGroup("Clock", "Where the team's day starts and ends, and the first day of a week.")]
public entity ClockSettings {
  [Setting("Time zone", Group = "Clock", Hint = "Days, weeks and months start at midnight here.")]
  TimeZoneInfo TimeZone = TimeZoneInfo.FindSystemTimeZoneById("UTC");
  [Setting("Weeks start on", Group = "Clock", Hint = "Monday in most of Europe; Sunday or Saturday elsewhere.")]
  DayOfWeek WeekStart = DayOfWeek.Monday;

  security {
    // The time is not a secret: a public page may say "open until 17:00" on it, and a background job counts on it.
    allow read when IsAnonymous || IsAuthenticated;
    allow create, update when ManagesClock;
  }
}

// ── reading it ────────────────────────────────────────────────────────────────────────────────────────────────────────

/// The clock in force: the zone days start in and the day a week starts.
public class AppClock {
  public TimeZoneInfo TimeZone = TimeZoneInfo.FindSystemTimeZoneById("UTC");
  public DayOfWeek WeekStart = DayOfWeek.Monday;

  /// The time on the team's wall at `instant` — what a person in the team's zone reads off their clock.
  public DateTime Local(DateTime instant) { return TimeZoneInfo.ConvertTimeFromUtc(instant, TimeZone); }

  /// The date on the team's wall at `instant`.
  public DateOnly DayOf(DateTime instant) { return DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(instant, TimeZone)); }

  /// The instant `day` begins on the team's wall — its midnight, in summer time or not.
  public DateTime StartOf(DateOnly day) { return TimeZoneInfo.ConvertTimeToUtc(day.ToDateTime(new TimeOnly(0, 0)), TimeZone); }

  /// The first day of the week that holds `day`.
  public DateOnly WeekOf(DateOnly day) {
    var back = (((int)day.DayOfWeek - (int)WeekStart) % 7 + 7) % 7;
    return day.AddDays(-back);
  }
}

/// The app's clock now — staff's choice, else the app's `ClockSetup`.
/// need: the business's time zone, what day and time it is where the business is — today's date on its wall, the start
/// need: of a day or a week there, a shift or a booking's local time — and the day its week starts
//  ⚠ NOT opening hours: the clock keeps a zone and a week start, never when the business is open. That is
//    `Osysharp.ServiceHours` (weekly windows, closures, `IsOpen`). A need line is what `osy kits find` ranks by, so a
//    claim here that this kit does not keep sent build run 6's "opening hours" search to the wrong kit.
public AppClock TheClock() {
  var row = ClockSettings.FirstOrDefault();
  if (row != null) { return new AppClock { TimeZone = row.TimeZone, WeekStart = row.WeekStart }; }
  var setup = App.Setting<ClockSetup>();
  return new AppClock { TimeZone = setup.TimeZone, WeekStart = setup.WeekStart };
}
