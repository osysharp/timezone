// The producer's test project for Osysharp.TimeZone — a bakery with a shop in Stockholm: the owner sets the clock its
// days are counted on, the bakers read it.
app ClockKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.TimeZone@0;
  use Osysharp.Ui;
}
